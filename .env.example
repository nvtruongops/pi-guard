# PI-Guard Environment Configuration

# Service Settings
GUARDRAIL_HOST=0.0.0.0
GUARDRAIL_PORT=8000
DASHBOARD_PORT=8501
LOG_LEVEL=INFO

# Security & Policy Defaults
DEFAULT_MODEL_TYPE=baseline  # options: baseline, transformer, onnx
BASELINE_MODEL_PATH=models/baseline/baseline_tfidf.joblib
TRANSFORMER_MODEL_PATH=models/transformer/deberta_v3_guardrail
ONNX_MODEL_PATH=models/onnx/deberta_v3_int8.onnx

# Policy Engine Thresholds (0.0 to 1.0)
POLICY_BLOCK_THRESHOLD=0.80
POLICY_REVIEW_THRESHOLD=0.50

# Target LLM Cloud API Endpoints & Keys (Pure Cloud API Calling)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

