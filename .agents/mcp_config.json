{
  "mcpServers": {
    "openalex": {
      "serverUrl": "https://mcp.openalex.org/mcp",
      "disabledTools": [
        "get_my_account",
        "claim_author_profile",
        "find_candidate_works",
        "submit_curations",
        "list_my_curations"
      ]
    },
    "arxiv": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "arxiv-mcp-server==0.7.2",
        "arxiv-mcp-server"
      ]
    },
    "jupyter": {
      "type": "stdio",
      "command": "mcp-server-jupyter",
      "description": "Jupyter Notebook MCP server for creating, editing, and executing Python notebook cells with network access"
    },
    "duckduckgo-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@ericthered926/duckduckgo-mcp-server"
      ],
      "description": "Internet and web search access for retrieving latest information, documentation, and research papers"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--headless"
      ],
      "description": "Browser automation and web scraping MCP server for fetching online pages"
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "description": "Knowledge Graph Memory for project context and decisions"
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "description": "Multi-step structured reasoning and analysis"
    },
    "officecli": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@officecli/officecli",
        "mcp"
      ],
      "description": "OfficeCLI MCP server for reading, editing, and automating Office documents (.docx, .xlsx, .pptx)"
    }
  }
}
