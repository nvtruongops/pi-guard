{
  "servers": {
    "arxiv": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "arxiv-mcp-server==0.7.2",
        "arxiv-mcp-server"
      ]
    },
    "kaggle": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://www.kaggle.com/mcp"]
    },
    "duckduckgo-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@ericthered926/duckduckgo-mcp-server"]
    },
    "jupyter": {
      "type": "stdio",
      "command": "mcp-server-jupyter"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--headless"]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "officecli": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@officecli/officecli", "mcp"]
    }
  }
}
