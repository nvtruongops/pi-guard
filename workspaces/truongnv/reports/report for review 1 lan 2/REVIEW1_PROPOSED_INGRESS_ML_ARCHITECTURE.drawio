  <diagram id="tier1_tfidf_routing_detail" name="L2 — TF-IDF + LR Routing (Detailed)">
    <mxGraphModel dx="5076" dy="2108" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1610" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="l2_region" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#EFF6FF;fontFamily=Arial;fontSize=17;shadow=0;fontStyle=1;dashed=1;dashPattern=8 5;spacingTop=14;" value="&lt;b&gt;L2 SCOPE — SPARSE LEXICAL CLASSIFIER&lt;/b&gt;&lt;br&gt;Input: canonical UTF-8 chunks from L1 · Output: one risk score and route candidate per chunk" vertex="1">
          <mxGeometry height="800" width="2750" x="25" y="205" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_input_iter" edge="1" parent="1" source="l2_input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4F46E5;strokeWidth=2;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;" target="l2_iter" value="ordered chunks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_iter_tfidf" edge="1" parent="1" source="l2_iter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0F766E;strokeWidth=2;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;" target="l2_tfidf" value="text batch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_tfidf_lr" edge="1" parent="1" source="l2_tfidf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;" target="l2_lr" value="sparse word TF-IDF X">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_lr_gate" edge="1" parent="1" source="l2_lr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2;fontColor=#334155;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;" target="l2_gate" value="p_attack + chunk/view IDs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_head" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=2;fillColor=#0F172A;fontFamily=Arial;fontSize=24;shadow=0;fontStyle=1;" value="&lt;b&gt;PI-GUARD · L2 — TF-IDF + LOGISTIC REGRESSION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Per-chunk routes: ALLOW candidate / REVIEW-&gt;L3 / BLOCK candidate · symbolic cutoffs&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="2720" x="40" y="35" as="geometry" />
        </mxCell>
        <mxCell id="l2_status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#7C2D12;strokeColor=#D97706;strokeWidth=2;fillColor=#FFF7ED;fontFamily=Arial;fontSize=14;shadow=0;" value="PROPOSED ARCHITECTURE. Word TF-IDF (1,2), max_features=20,000 + Logistic Regression is the selected lexical baseline; char_wb (3,5) remains a separate project ablation." vertex="1">
          <mxGeometry height="42" width="2720" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="l2_input" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#1E1B4B;strokeColor=#4F46E5;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="INPUT DTO · CanonicalTextEnvelope.chunks[]&lt;br&gt;chunk_id/view_id/text_utf8/token_count/source refs/offsets/coverage. Same-process Python object; no raw bytes or internal HTTP." vertex="1">
          <mxGeometry height="320" width="390" x="55" y="285" as="geometry" />
        </mxCell>
        <mxCell id="l2_iter" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#1E1B4B;strokeColor=#6366F1;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;rounded=0;" value="PROPOSED · l2_scorer.py::iter_scoring_units(envelope, batch_size)&lt;br&gt;Build one sample per chunk/view; preserve IDs and source map. Batch size is a deployment setting, not a fixed paper value." vertex="1">
          <mxGeometry height="320" width="355" x="485" y="285" as="geometry" />
        </mxCell>
        <mxCell id="l2_tfidf" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#134E4A;strokeColor=#0F766E;strokeWidth=2;fillColor=#F0FDFA;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;rounded=0;" value="PROPOSED RUNTIME CALL · word_vectorizer.transform(texts)&lt;br&gt;Paper baseline: word analyzer, ngram_range=(1,2), max_features=20_000. char_wb(3,5) is an optional validated ablation; fit vocabulary on training split only." vertex="1">
          <mxGeometry height="320" width="455" x="880" y="285" as="geometry" />
        </mxCell>
        <mxCell id="l2_lr" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#4C1D95;strokeColor=#7C3AED;strokeWidth=2;fillColor=#F5F3FF;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;rounded=0;" value="PROPOSED RUNTIME CALL · classifier.predict_proba(X)&lt;br&gt;Extract the attack-class score and retain chunk/view IDs + artifact version. Check calibration before interpreting p_attack as calibrated risk." vertex="1">
          <mxGeometry height="320" width="420" x="1375" y="285" as="geometry" />
        </mxCell>
        <mxCell id="l2_gate" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#78350F;strokeColor=#D97706;strokeWidth=2;fillColor=#FFFBEB;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;rounded=0;shape=rhombus;perimeter=rhombusPerimeter;" value="ROUTE DECISION&lt;br&gt;Emit one route per chunk/view using symbolic τ_allow / τ_block." vertex="1">
          <mxGeometry height="320" width="390" x="1835" y="285" as="geometry" />
        </mxCell>
        <mxCell id="l2_low" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#F0FDF4;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" value="ChunkRouteResult(route=ALLOW)&lt;br&gt;p_attack ≤ τ_allow&lt;br&gt;Candidate only; API decides after full-request aggregation." vertex="1">
          <mxGeometry height="205" width="445" x="2265" y="285" as="geometry" />
        </mxCell>
        <mxCell id="l2_mid" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#78350F;strokeColor=#D97706;strokeWidth=2;fillColor=#FFFBEB;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" value="ChunkRouteResult(route=REVIEW)&lt;br&gt;τ_allow &lt; p_attack &lt; τ_block&lt;br&gt;API dispatches this chunk to L3; no human queue." vertex="1">
          <mxGeometry height="205" width="445" x="2265" y="535" as="geometry" />
        </mxCell>
        <mxCell id="l2_high" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#7F1D1D;strokeColor=#DC2626;strokeWidth=2;fillColor=#FEF2F2;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" value="ChunkRouteResult(route=BLOCK)&lt;br&gt;p_attack ≥ τ_block&lt;br&gt;Candidate only; API applies the request-level rule." vertex="1">
          <mxGeometry height="205" width="445" x="2265" y="785" as="geometry" />
        </mxCell>
        <mxCell id="l2_tool_calls" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#0F172A;strokeColor=#475569;strokeWidth=2;fillColor=#F8FAFC;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;" value="OFFLINE FIT · train_l2.py (PROPOSED)&lt;br&gt;Split by original request/file before chunking. TfidfVectorizer(analyzer=&quot;word&quot;, ngram_range=(1,2), max_features=20_000).fit(train_texts) → LogisticRegression.fit(X_train, y_train) → validate → save one versioned MODEL_BUNDLE. No benchmark metric is implied." vertex="1">
          <mxGeometry height="250" width="660" x="40" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="l2_error" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#7F1D1D;strokeColor=#DC2626;strokeWidth=2;fillColor=#FEF2F2;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="L2 ERROR EXIT · NO BENIGN DEFAULT&lt;br&gt;MODEL_UNAVAILABLE · VECTORIZE_FAILED · INFERENCE_FAILED · EMPTY_VECTOR · OUTPUT_INVALID · MISSING_CHUNK_SCORE · INVALID_THRESHOLD_CONFIG · MISSING_COVERAGE&lt;br&gt;Return stage=L2 + error_code to API; never route an error or forward it." vertex="1">
          <mxGeometry height="250" width="730" x="2030" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="l2_validation" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#7C2D12;strokeColor=#D97706;strokeWidth=2;fillColor=#FFF7ED;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;" value="THRESHOLD / FEATURE VALIDATION&lt;br&gt;Select τ_allow and τ_block on project validation only; require 0 ≤ τ_allow &lt; τ_block ≤ 1; freeze before test. No numeric cutoff is assigned. char_wb is an optional project ablation." vertex="1">
          <mxGeometry height="250" width="600" x="1410" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="l2_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#334155;strokeColor=#64748B;strokeWidth=2;fillColor=#F1F5F9;fontFamily=Arial;fontSize=16;shadow=0;fontStyle=1;shape=parallelogram;perimeter=parallelogramPerimeter;" value="OUTPUT DTO · ChunkRouteResult[]&lt;br&gt;{request_id, chunk_id, view_id, p_attack, route_candidate, model_version, config_version}. Exactly one result per input chunk/view; API receives all route states + expected IDs. Missing/invalid score fails closed." vertex="1">
          <mxGeometry height="110" width="2670" x="40" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="l2_runtime_setup" value="SERVICE STARTUP + REQUEST CALLS · l2_scorer.py (PROPOSED)&lt;br&gt;Startup: joblib.load(MODEL_BUNDLE); verify class order, feature config and artifact version. Per request: vectorizer.transform(batch) → classifier.predict_proba(X) → route_chunk(...). No .fit in serving." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#0F172A;strokeColor=#2563EB;strokeWidth=2;fillColor=#EFF6FF;fontFamily=Arial;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="1040" width="660" height="250" as="geometry" />
        </mxCell>
        <mxCell id="l2_route_output" value="ChunkRouteResult[] · PYTHON DTO&lt;br&gt;One result per chunk/view" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#EFF6FF;fontFamily=Arial;fontSize=15;fontStyle=1;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="1835" y="625" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_gate_to_dto" value="p_attack + chunk/view IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.5;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="l2_gate" target="l2_route_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_dto_allow" value="p_attack ≤ τ_allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="l2_route_output" target="l2_low">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_dto_review" value="τ_allow &lt; p_attack &lt; τ_block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.5;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="l2_route_output" target="l2_mid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_e_dto_block" value="p_attack ≥ τ_block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="l2_route_output" target="l2_high">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tier2_deberta_api_stream_detail" name="L3 — DeBERTa → API → Streaming (Detailed)">
    <mxGraphModel dx="2800" dy="1610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dashboard_region" value="EXTERNAL DASHBOARD BOUNDARY" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontColor=#0F172A;strokeColor=#64748B;strokeWidth=2;fillColor=#F8FAFC;fontFamily=Arial;fontSize=16;fontStyle=1;dashed=1;dashPattern=8 5;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="2370" y="205" width="405" height="935" as="geometry" />
        </mxCell>
        <mxCell id="target_region" value="EXTERNAL TARGET LLM · BLACK-BOX BOUNDARY" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontColor=#0F172A;strokeColor=#16A34A;strokeWidth=2;fillColor=#F0FDF4;fontFamily=Arial;fontSize=16;fontStyle=1;dashed=1;dashPattern=8 5;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1965" y="205" width="385" height="935" as="geometry" />
        </mxCell>
        <mxCell id="l3_region" value="L3 · PROJECT CONTEXTUAL CLASSIFIER&lt;br&gt;Receives API-routed REVIEW chunks (or all chunks before cutoff validation); returns window predictions only." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontColor=#4C1D95;strokeColor=#7C3AED;strokeWidth=2;fillColor=#F5F3FF;fontFamily=Arial;fontSize=17;shadow=0;fontStyle=1;dashed=1;dashPattern=8 5;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="205" width="1080" height="760" as="geometry" />
        </mxCell>
        <mxCell id="api_region" value="FASTAPI · ROUTING, COVERAGE, AGGREGATION + FINAL DECISION&lt;br&gt;One in-process orchestrator. Final request status is ALLOW or BLOCK." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#EFF6FF;fontFamily=Arial;fontSize=17;shadow=0;fontStyle=1;dashed=1;dashPattern=8 5;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1130" y="205" width="810" height="960" as="geometry" />
        </mxCell>
        <mxCell id="l3_head" value="PI-GUARD · L3 MODEL → API AGGREGATION → ALLOW-GATED PROVIDER CALL → BLACK-BOX TARGET LLM → DASHBOARD" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=2;fillColor=#0F172A;fontFamily=Arial;fontSize=24;shadow=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="35" width="2720" height="95" as="geometry" />
        </mxCell>
        <mxCell id="l3_status" value="PROPOSAL vs CURRENT SOURCE: The project classifier checkpoint must be trained. Current main.py wires MockLLMProvider; provider.generate(...) returns a complete string. Upload, this cascade and token streaming are not wired." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#7C2D12;strokeColor=#D97706;strokeWidth=2;fillColor=#FFF7ED;fontFamily=Arial;fontSize=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="2720" height="42" as="geometry" />
        </mxCell>
        <mxCell id="l3_in" value="1 · API-ROUTED INPUT DTO&lt;br&gt;RoutedChunk{request_id, chunk_id, view_id, text_utf8, source_refs, offsets, l2_score, config_version}. API sends REVIEW chunks; pre-validation may send all. No file bytes or TF-IDF vectors." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#1E1B4B;strokeColor=#6366F1;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="295" width="300" height="250" as="geometry" />
        </mxCell>
        <mxCell id="l3_tokenize" value="2 · PROPOSED tokenizer.py / window_builder.py&lt;br&gt;tokenizer(text, add_special_tokens=True) → build_windows(...). Keep window IDs/offsets; check ≤512 model positions including special tokens; never silently truncate." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#4C1D95;strokeColor=#8B5CF6;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="395" y="295" width="310" height="250" as="geometry" />
        </mxCell>
        <mxCell id="l3_model" value="3 · PROPOSED INFERENCE · PyTorch&lt;br&gt;model.eval(); with torch.inference_mode(): logits=model(**batch).logits; class_scores=softmax(logits).&lt;br&gt;microsoft/deberta-v3-base is a general backbone, not a trained project detector." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#4C1D95;strokeColor=#7C3AED;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="745" y="295" width="320" height="250" as="geometry" />
        </mxCell>
        <mxCell id="l3_output" value="4 · OUTPUT DTO · WindowPrediction[]&lt;br&gt;{request_id, chunk_id, view_id, window_id, class_scores, predicted_class, model_version, source_refs}. One prediction per window; no request-level decision here." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#4C1D95;strokeColor=#7C3AED;strokeWidth=2;fillColor=#FAF5FF;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="55" y="610" width="650" height="175" as="geometry" />
        </mxCell>
        <mxCell id="api_input" value="5 · INGRESS DTO · ChunkRouteResult[]&lt;br&gt;Every L2 route result + expected chunk/view/window IDs + stage errors. Retain records by request_id." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="1160" y="295" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="api_coverage" value="7 · COVERAGE + REQUEST AGGREGATOR · proposed api_orchestrator.py&lt;br&gt;Receive L2 route results + L3 WindowPrediction[]; check expected window/chunk coverage, duplicate/invalid results, then aggregate by the validated request rule. Any gap/error branches to API_ERROR." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="500" width="735" height="170" as="geometry" />
        </mxCell>
        <mxCell id="api_allow" value="FINAL ALLOW&lt;br&gt;Complete coverage + validated request rule. The sole trigger for a downstream LLM call." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#F0FDF4;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="1160" y="875" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="api_block" value="FINAL BLOCK&lt;br&gt;Reject request. No provider call." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontColor=#7F1D1D;strokeColor=#DC2626;strokeWidth=2;fillColor=#FEF2F2;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="1690" y="875" width="205" height="95" as="geometry" />
        </mxCell>
        <mxCell id="target_llm" value="EXTERNAL TARGET LLM API&lt;br&gt;Provider/model selected by server configuration; outside PI-Guard trust boundary." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=16;shadow=0;fontStyle=1;rounded=0;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="1990" y="255" width="335" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" value="EXTERNAL DASHBOARD&lt;br&gt;Displays final ALLOW/BLOCK status and the completed answer. Token events appear only if a stream-capable provider is implemented and final ALLOW has passed." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=16;shadow=0;fontStyle=1;rounded=0;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="2390" y="300" width="355" height="320" as="geometry" />
        </mxCell>
        <mxCell id="api_errors" value="API_ERROR DTO&lt;br&gt;{request_id, stage, error_code}; missing/duplicate result, stage failure, or incomplete coverage → fail closed; never call the provider." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#7F1D1D;strokeColor=#DC2626;strokeWidth=2;fillColor=#FEF2F2;fontFamily=Arial;fontSize=14;shadow=0;fontStyle=1;rounded=0;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1090" width="735" height="65" as="geometry" />
        </mxCell>
        <mxCell id="l3_tools" value="L3 STARTUP + REQUEST CALLS · PROPOSED&lt;br&gt;Startup: load_l3_model.py loads tokenizer + trained classifier checkpoint and checks labels. Request: API router → tokenizer + special tokens → ≤512-position windows → model.eval() / torch.inference_mode() → class scores → WindowPrediction[] → API coverage/aggregation. No training, checkpoint or measured cascade is claimed here." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#0F172A;strokeColor=#475569;strokeWidth=2;fillColor=#F8FAFC;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1195" width="2670" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l3_scope" value="RESPONSIBILITY BOUNDARY: L1 extracts/chunks; L2 scores each chunk/view; API routes REVIEW and checks coverage; L3 returns class predictions; only API emits final ALLOW/BLOCK and triggers the provider after ALLOW." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#334155;strokeColor=#64748B;strokeWidth=2;fillColor=#F1F5F9;fontFamily=Arial;fontSize=16;shadow=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1495" width="2670" height="95" as="geometry" />
        </mxCell>
        <mxCell id="l3_events" value="PROPOSED DASHBOARD EVENTS&lt;br&gt;stage_started · extraction_done · chunk_scores · route (ALLOW / REVIEW→L3 / BLOCK) · final_decision (ALLOW/BLOCK) · llm_completion (after ALLOW) · llm_token (only after a stream-capable provider is implemented) · done/error" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#0F172A;strokeColor=#475569;strokeWidth=2;fillColor=#F8FAFC;fontFamily=Arial;fontSize=15;shadow=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1350" width="2670" height="130" as="geometry" />
        </mxCell>
        <mxCell id="api_decision" value="&lt;b&gt;FINAL REQUEST DECISION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete coverage + validated aggregation rule&lt;br&gt;&lt;br&gt;Emit final ALLOW or BLOCK only." style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Arial;fontSize=12;fontStyle=1;shape=rhombus;perimeter=rhombusPerimeter;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1400" y="710" width="260" height="145" as="geometry" />
        </mxCell>
        <mxCell id="l3_setup" value="MODEL STARTUP / CHECKPOINT SETUP · load_l3_model.py (PROPOSED)&lt;br&gt;AutoTokenizer.from_pretrained(&quot;microsoft/deberta-v3-base&quot;); load the trained project AutoModelForSequenceClassification checkpoint; validate id2label + model version. Missing/untrained head → MODEL_UNAVAILABLE." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#4C1D95;strokeColor=#7C3AED;strokeWidth=2;fillColor=#FAF5FF;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="745" y="610" width="320" height="175" as="geometry" />
        </mxCell>
        <mxCell id="api_router" value="6 · API ROUTER · proposed api_orchestrator.py&lt;br&gt;Select REVIEW chunks → RoutedChunk[]; before cutoffs validate, dispatch all chunks. This happens before L3 inference." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1530" y="295" width="365" height="160" as="geometry" />
        </mxCell>
        <mxCell id="provider_call" value="8 · PROVIDER ADAPTER · src/llm/provider.py interface&lt;br&gt;PROPOSED gate: call only after final ALLOW. Validate server-side provider/model config; read API key from server environment; call generate(approved_prompt, system_prompt); normalize response/errors. Current interface returns str; stream() requires new provider code. Timeout/auth/provider errors → UPSTREAM_LLM_ERROR." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#1E3A8A;strokeColor=#2563EB;strokeWidth=2;fillColor=#EFF6FF;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="985" width="735" height="95" as="geometry" />
        </mxCell>
        <mxCell id="target_llm_process" value="BLACK-BOX GENERATION PROCESS · EXTERNAL&lt;br&gt;1. Accept the approved system/user message request.&lt;br&gt;2. Apply provider-owned prompt, policy and serving configuration.&lt;br&gt;3. Generate completion with provider-controlled model internals; PI-Guard cannot inspect weights, hidden prompts, tools or KV state.&lt;br&gt;4. Return a completion, optional stream deltas, or provider error." style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1990" y="385" width="335" height="360" as="geometry" />
        </mxCell>
        <mxCell id="l3_e_in_tok" value="RoutedChunk.text + IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="l3_in" target="l3_tokenize">
          <mxGeometry relative="1" as="geometry" />
