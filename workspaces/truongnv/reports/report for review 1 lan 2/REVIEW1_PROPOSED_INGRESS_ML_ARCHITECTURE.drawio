        <mxCell id="e_pdf_scanned_ocr" value="NO · scanned page only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="pdf_text_layer_gate" target="adapter_ocr">
