        <mxCell id="one_count_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#64748B;strokeWidth=1;fillColor=#F1F5F9;fontFamily=Arial;fontSize=11;shadow=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;THREE PROCESSING TIERS · ONE FASTAPI BACKEND&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;L1/L2/L3 exchange in-process Python DTOs: CanonicalTextEnvelope → ChunkRouteResult[] → RoutedChunk[] → WindowPrediction[] → API. Screen-readable summaries: pages 2–5; tier details: pages 6–8.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="58" width="2730" x="35" y="105" as="geometry" />
        </mxCell>
        <mxCell id="one_input" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#64748B;strokeWidth=1;fillColor=#F1F5F9;fontFamily=Arial;fontSize=13;shadow=0;spacingLeft=55;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;USER INPUT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Prompt text or upload&lt;br&gt;.txt · .md · .json · .py · .pdf · .docx&lt;br&gt;Untrusted content&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="175" x="30" y="500" as="geometry" />
        </mxCell>
        <mxCell id="one_l1_validate" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1;fillColor=#ECFDF5;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;1. VALIDATE REQUEST / FILE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Check type, signature, suffix/MIME, byte/page/expanded-size limits; reject unsafe or unsupported files.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="365" x="260" y="330" as="geometry" />
        </mxCell>
        <mxCell id="one_l1_router" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1;fillColor=#ECFDF5;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;2. PYTHON DOCUMENT TEXT EXTRACTOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;code&gt;document_text_extractor.extract(...)&lt;/code&gt; — one entry point with format-specific adapters:&lt;br&gt;TXT/MD/PY: strict text decoding (read Python as text only) · JSON: stdlib parse, text leaves + key paths&lt;br&gt;PDF: PyMuPDF page text; scanned pages: Tesseract OCR · DOCX: python-docx paragraphs/tables&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="365" x="260" y="480" as="geometry" />
        </mxCell>
        <mxCell id="one_l1_chunk" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1;fillColor=#ECFDF5;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;3. NORMALIZE + VIEWS + TOKEN-BOUNDED CHUNKS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Preserve provenance/offsets; create bounded encoded views. Prefer page/paragraph boundaries; count with the DeBERTa tokenizer (tokenizer only). &lt;b&gt;Candidate:&lt;/b&gt; 256 tokens, overlap 32; validation sweep: target {128,256,384}, overlap {0,32,64}. Each model window ≤512 positions including special tokens; never truncate. Configured byte/token caps; exceeding a cap returns an error.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="365" x="260" y="720" as="geometry" />
        </mxCell>
        <mxCell id="one_l1_out" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1;fillColor=#ECFDF5;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;L1 OUTPUT — CANONICAL TEXT ENVELOPE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;In-process UTF-8 Python DTO: request_id; chunks[] = chunk_id, view_id, text_utf8, token_count, source/page/section, offsets; extraction/coverage + config_version. Raw bytes stop at L1.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="365" x="260" y="960" as="geometry" />
        </mxCell>
        <mxCell id="one_l1_err" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B91C1C;strokeWidth=1;fillColor=#FEF2F2;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;L1 ERROR EXIT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stage=L1: INVALID_REQUEST • UNSUPPORTED_TYPE • TOO_LARGE • DECODE/EXTRACT/OCR/NORMALIZE/CHUNK_FAILED • EMPTY/INCOMPLETE_COVERAGE&lt;br&gt;Never convert an error to benign; fail closed.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="365" x="260" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_in" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B45309;strokeWidth=1;fillColor=#FFFBEB;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;L2 INPUT DTO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CanonicalTextEnvelope → chunk_id + view_id + text + source offsets; each chunk/view pair is one scoring unit.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="690" y="290" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_word" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B45309;strokeWidth=1;fillColor=#FFFBEB;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;WORD N-GRAM ANALYZER · PAPER BASELINE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Paper-faithful baseline: word (1,2), up to 20,000 features. Optional PI-Guard ablation: char_wb (3,5), requiring validation. N-gram ranges describe feature lengths, not chunk counts; both analyze the same chunk text when the ablation is enabled.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="690" y="403" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_tfidf" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B45309;strokeWidth=1;fillColor=#FFFBEB;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;TF-IDF VECTORIZER · SCIKIT-LEARN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The fitted word vectorizer creates sparse features; inference calls transform on chunk batches. Character features are added only when an explicitly selected ablation is validated. L3 never receives these vectors.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="360" x="690" y="545" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_sparse" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B45309;strokeWidth=1;fillColor=#FFFBEB;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;SPARSE TF-IDF VECTOR xᵢ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Sparse lexical representation; not a contextual embedding.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="170" x="680" y="698" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_linear" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B45309;strokeWidth=1;fillColor=#FFFBEB;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;LINEAR CLASSIFIER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Binary Logistic Regression baseline: benign / suspect&lt;br&gt;Scores each chunk; preserves chunk_id + view_id.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="175" x="890" y="698" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_score" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#A16207;strokeWidth=1;fillColor=#FEFCE8;fontFamily=Arial;fontSize=11;shadow=0;shape=rhombus;perimeter=rhombusPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;PER-CHUNK SCORE + THREE ROUTES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;p_attack = LogisticRegression.predict_proba(TF-IDF(chunk))[attack]&lt;br&gt;ALLOW candidate / REVIEW -&gt; L3 / BLOCK candidate. API aggregates the request.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="360" x="690" y="860" as="geometry" />
        </mxCell>
        <mxCell id="one_l2_err" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B91C1C;strokeWidth=1;fillColor=#FEF2F2;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;L2 ERROR EXIT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stage=L2: MODEL_UNAVAILABLE • VECTORIZE_FAILED • INFERENCE_FAILED • EMPTY_VECTOR • OUTPUT_INVALID&lt;br&gt;Fail closed; do not forward.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="360" x="690" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="one_l3_in" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#6D28D9;strokeWidth=1;fillColor=#F5F3FF;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;L3 INPUT · API-ROUTED HANDOFF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The API passes a RoutedChunk DTO for the middle band only: request_id, chunk_id, view_id, text_utf8 + source offsets + L2 score. No file bytes or complete upload are passed.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="350" x="1110" y="320" as="geometry" />
        </mxCell>
        <mxCell id="one_l3_token" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#6D28D9;strokeWidth=1;fillColor=#F5F3FF;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;TOKENIZER + WINDOW BUILDER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DeBERTa tokenizer → subword IDs + special tokens; model limit is 512 positions. Check before inference; never silently truncate. Split an overlong chunk into sliding windows only when needed; preserve window_id + offsets.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="350" x="1110" y="435" as="geometry" />
        </mxCell>
        <mxCell id="one_l3_encoder" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#6D28D9;strokeWidth=1;fillColor=#F5F3FF;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;PRETRAINED BACKBONE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;microsoft/deberta-v3-base; a general backbone, not yet a prompt-injection detector.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="350" x="1110" y="590" as="geometry" />
        </mxCell>
        <mxCell id="one_l3_head" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#6D28D9;strokeWidth=1;fillColor=#F5F3FF;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;PROJECT SEQUENCE-CLASSIFICATION HEAD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Benign • Prompt Injection • Jailbreak&lt;br&gt;The project must train the classification head/checkpoint on its dataset.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="350" x="1110" y="740" as="geometry" />
        </mxCell>
        <mxCell id="one_l3_scores" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#6D28D9;strokeWidth=1;fillColor=#F5F3FF;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b&gt;L3 OUTPUT — CLASS PREDICTION DTO&lt;/b&gt;&lt;br&gt;Per chunk/window: class scores and label. Return benign or attack predictions to API; these are not request-level decisions.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="350" x="1110" y="900" as="geometry" />
        </mxCell>
        <mxCell id="one_l3_err" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B91C1C;strokeWidth=1;fillColor=#FEF2F2;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;L3 ERROR EXIT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stage=L3: MODEL_UNAVAILABLE • TOKENIZE_FAILED • INFERENCE_FAILED • OUTPUT_INVALID; fail closed.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="350" x="1110" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="one_api_input" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1;fillColor=#F8FAFC;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b&gt;API INPUT DTOs&lt;/b&gt;&lt;br&gt;All L2 ChunkRouteResult[] + L3 WindowPrediction[]; expected IDs, coverage status, and stage errors.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="1540" y="305" as="geometry" />
        </mxCell>
        <mxCell id="one_api_aggregate" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1;fillColor=#F8FAFC;fontFamily=Arial;fontSize=11;shadow=0;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b&gt;API ORCHESTRATOR · COVERAGE + AGGREGATION&lt;/b&gt;&lt;br&gt;Dispatch REVIEW chunks to L3 (or all chunks until cutoffs are validated); join results by IDs and check complete request coverage.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="1540" y="440" as="geometry" />
        </mxCell>
        <mxCell id="one_api_rules" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1;fillColor=#F8FAFC;fontFamily=Arial;fontSize=12;shadow=0;shape=rhombus;perimeter=rhombusPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;FINAL REQUEST DECISION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Apply the validated request rule to complete L2/L3 results: final ALLOW or BLOCK. REVIEW is never a final status.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="1540" y="640" as="geometry" />
        </mxCell>
        <mxCell id="one_api_error" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B91C1C;strokeWidth=1;fillColor=#FEF2F2;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;FAIL-CLOSED CONTRACT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;An L1/L2/L3 error, empty text/vector, missing score, or missing chunk is never benign/ALLOW; do not forward.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="340" x="1540" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="one_api_events" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#A16207;strokeWidth=1;fillColor=#FEFCE8;fontFamily=Arial;fontSize=11;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b&gt;PROPOSED STREAM EVENTS&lt;/b&gt;&lt;br&gt;stage_started • extraction_done • chunk_scores • route (ALLOW / REVIEW→L3 / BLOCK) • final_decision (ALLOW/BLOCK) • llm_token (ALLOW only) • done/error&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="255" x="1930" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="one_allow" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1;fillColor=#ECFDF5;fontFamily=Arial;fontSize=12;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;FINAL ALLOW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Forward only the fully inspected request; the sole path to the target LLM.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="255" x="1930" y="510" as="geometry" />
        </mxCell>
        <mxCell id="one_llm" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#64748B;strokeWidth=1;fillColor=#F1F5F9;fontFamily=Arial;fontSize=12;shadow=0;spacingLeft=60;rounded=0;dashed=1;dashPattern=8 4;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;TARGET LLM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;External service; called by the API only after final ALLOW.&lt;br&gt;Response is forwarded to the dashboard.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="440" x="2300" y="500" as="geometry" />
        </mxCell>
        <mxCell id="one_failstop" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#B91C1C;strokeWidth=1;fillColor=#FEF2F2;fontFamily=Arial;fontSize=12;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ERROR / FAIL-STOP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Return stage + error_code; end the request; do not call another tier or forward to the LLM.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="255" x="1930" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="one_dashboard" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontColor=#0F172A;strokeColor=#6D28D9;strokeWidth=1;fillColor=#F5F3FF;fontFamily=Arial;fontSize=12;shadow=0;spacingLeft=62;rounded=0;dashed=1;dashPattern=8 4;" value="&lt;div style=&quot;font-family:Arial,sans-serif;line-height:1.3&quot;&gt;&lt;b&gt;EXTERNAL STREAMING DASHBOARD&lt;/b&gt;&lt;br&gt;Displays the final decision; receives response tokens only after ALLOW.&lt;/div&gt;" vertex="1">
