        <mxCell id="t0_header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1;fillColor=#0F172A;fontFamily=Arial;fontSize=24;fontStyle=1;shadow=0;" value="PI-GUARD · L1 — INGRESS &amp; PREPROCESSING&lt;br&gt;Separate prompt and upload paths → validate → extract upload text → normalize/chunk → CanonicalTextEnvelope" vertex="1">
          <mxGeometry height="100" width="2720" x="40" y="35" as="geometry" />
        </mxCell>
        <mxCell id="t0_subtitle" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=5;fontColor=#334155;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;" value="PROPOSED DESIGN. Current /v1/chat/guardrail accepts JSON prompt only; source has no UploadFile endpoint, MAX_UPLOAD_BYTES setting, or OCR dependency. Module names below are proposals." vertex="1">
          <mxGeometry height="28" width="2680" x="55" y="135" as="geometry" />
        </mxCell>
        <mxCell id="t0_error" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontColor=#991B1B;strokeColor=#DC2626;strokeWidth=2;fillColor=#FEF2F2;fontFamily=Arial;fontSize=14;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;b&gt;L1 ERROR EXIT · FAIL-CLOSED&lt;/b&gt;&lt;br&gt;&lt;br&gt;INVALID_REQUEST · UNSUPPORTED_TYPE · TYPE_SIGNATURE_MISMATCH · TOO_LARGE / INPUT_LIMIT_EXCEEDED · INVALID_UTF8 · DECODE_FAILED · EXTRACT_FAILED · OCR_FAILED · NORMALIZE_FAILED · CHUNK_FAILED · EMPTY/PARTIAL_COVERAGE&lt;br&gt;&lt;br&gt;Return stage=L1 + error_code; do not create benign chunks or call L2/LLM." vertex="1">
          <mxGeometry height="220" width="2720" x="40" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="input_prompt" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="PROMPT INPUT DTO&lt;br&gt;JSON request: prompt: str&lt;br&gt;Untrusted text passes directly to text handling; it never enters file parsers or OCR." vertex="1">
          <mxGeometry height="205" width="340" x="70" y="310" as="geometry" />
        </mxCell>
        <mxCell id="input_upload" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="FILE UPLOAD DTO · PROPOSED&lt;br&gt;FastAPI UploadFile → bounded bytes&lt;br&gt;Allowlist: .txt · .md · .json · .py · .pdf · .docx&lt;br&gt;Filename and MIME are untrusted metadata." vertex="1">
          <mxGeometry height="245" width="340" x="70" y="590" as="geometry" />
        </mxCell>
        <mxCell id="input_contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;" value="&lt;b&gt;UNTRUSTED INPUT RULE&lt;/b&gt;&lt;br&gt;Prompts and files are untrusted. Read .py only as text; never import, eval, exec, or run an embedded macro/script." vertex="1">
          <mxGeometry height="165" width="340" x="70" y="900" as="geometry" />
        </mxCell>
        <mxCell id="gate_prompt" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#D97706;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · request_validator.py::validate_prompt(request)&lt;br&gt;Check schema, JSON encoding and empty content. Preserve original prompt text; do not rewrite away obfuscation signals." vertex="1">
          <mxGeometry height="205" width="380" x="505" y="330" as="geometry" />
        </mxCell>
        <mxCell id="gate_upload" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#D97706;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · request_validator.py::validate_upload(file)&lt;br&gt;1) Check allowlist, MIME + signature/structure.&lt;br&gt;2) Enforce configured MAX_UPLOAD_BYTES / MAX_EXTRACTED_TOKENS; no numeric cap is known or assigned, and no upload cap exists in current src.&lt;br&gt;3) Over configured limit → 413 / TOO_LARGE. Do not parse before validation; never save/execute client paths." vertex="1">
          <mxGeometry height="330" width="380" x="505" y="600" as="geometry" />
        </mxCell>
        <mxCell id="gate_contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#D97706;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;" value="&lt;b&gt;NO PARSING BEFORE VALIDATION&lt;/b&gt;&lt;br&gt;FastAPI receives the byte stream and passes only valid files to the dispatcher. Never save or execute a client-provided path." vertex="1">
          <mxGeometry height="135" width="380" x="505" y="980" as="geometry" />
        </mxCell>
        <mxCell id="extract_dispatch" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED UPLOAD DISPATCH · document_text_extractor.py::extract_upload(validated_file)&lt;br&gt;Upload bytes only; dispatch by verified format. Prompt input bypasses this function. Each adapter returns ordered text segments + source references." vertex="1">
          <mxGeometry height="145" width="930" x="985" y="240" as="geometry" />
        </mxCell>
        <mxCell id="adapter_text" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · text_reader.py::read_text_strict(...)&lt;br&gt;.txt / .md / .py: strict UTF-8 decode + BOM handling. Prompt text enters here as a string without file decoding. Invalid bytes → INVALID_UTF8; never silent replacement." vertex="1">
          <mxGeometry height="235" width="445" x="985" y="440" as="geometry" />
        </mxCell>
        <mxCell id="adapter_json" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · json_extract.py::extract_json_text_leaves(...) · Python stdlib json&lt;br&gt;Parse structure; collect string leaves and key paths in source order. Invalid JSON → extraction error; never scan arbitrary bytes as text." vertex="1">
          <mxGeometry height="235" width="455" x="1470" y="440" as="geometry" />
        </mxCell>
        <mxCell id="adapter_pdf" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · pdf_extract.py::extract_pdf_pages(...) · PyMuPDF (fitz)&lt;br&gt;Extract text page-by-page in reading order; record page IDs and text-layer coverage. A page with selectable text bypasses OCR." vertex="1">
          <mxGeometry height="205" width="445" x="985" y="720" as="geometry" />
        </mxCell>
        <mxCell id="adapter_ocr" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · ocr.py::ocr_pdf_pages(...) · Tesseract&lt;br&gt;Run only on PDF pages with no extractable text layer. Return text + page reference; OCR error/incomplete coverage fails closed." vertex="1">
          <mxGeometry height="130" width="450" x="1480" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="adapter_docx" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#0F766E;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="PROPOSED · docx_extract.py::extract_docx_content(...) · python-docx&lt;br&gt;Read paragraphs/tables in document order. Never execute macros, embedded scripts or external links; retain section/offset provenance." vertex="1">
          <mxGeometry height="235" width="455" x="1460" y="720" as="geometry" />
        </mxCell>
        <mxCell id="canonical_assemble" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#7C3AED;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="ASSEMBLE TEXT SEGMENTS&lt;br&gt;Join prompt or parser output in source order. Retain source_id, page/section, offsets, and extraction status. Unreadable content stays an error." vertex="1">
          <mxGeometry height="185" width="320" x="2070" y="285" as="geometry" />
        </mxCell>
        <mxCell id="canonical_views" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#7C3AED;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="&lt;b&gt;UNICODE + ENCODED-VIEW PROCESSOR&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;build_inspection_views(source_text, decode_policy)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Keep original text and offset map; create NFKC normalized view.&lt;br&gt;• Add bounded UTF-8 views for recognized JSON escapes, URL / HTML entities or Base64.&lt;br&gt;• Never overwrite the source, recurse without limits, or eval / exec.&lt;br&gt;&lt;br&gt;Retain source/view IDs so L2 scores can be traced to the submitted content." vertex="1">
          <mxGeometry height="350" width="320" x="2070" y="535" as="geometry" />
        </mxCell>
        <mxCell id="canonical_metadata" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#0F172A;strokeColor=#7C3AED;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;rounded=0;" value="&lt;b&gt;CHUNK + COVERAGE CHECK&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;chunk_text_views(views, chunk_config)&lt;br&gt;validate_extraction_coverage(...)&lt;/font&gt;&lt;br&gt;&lt;br&gt;Count with the DeBERTa tokenizer (tokenizer only) and prefer page/paragraph boundaries; split long segments at sentence/token boundaries. Candidate: 256 tokens + overlap 32; validation sweep: 128/256/384 × 0/32/64. Model window ≤512 positions including special tokens; never truncate. Preserve chunk_id/source refs/offsets. Missing regions/pages → error." vertex="1">
          <mxGeometry height="180" width="320" x="2070" y="950" as="geometry" />
        </mxCell>
        <mxCell id="output_envelope" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;b&gt;CanonicalTextEnvelope → L2 · PYTHON DTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;request_id&lt;br&gt;chunks[]: chunk_id, view_id,&lt;br&gt;text_utf8, token_count&lt;br&gt;source_refs/page/section,&lt;br&gt;start/end offsets&lt;br&gt;coverage_status, config_version&lt;/font&gt;&lt;br&gt;&lt;br&gt;Same FastAPI process: only text + provenance pass to L2; raw upload bytes stop at L1." vertex="1">
          <mxGeometry height="390" width="280" x="2455" y="385" as="geometry" />
        </mxCell>
        <mxCell id="output_l1" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontColor=#14532D;strokeColor=#16A34A;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;shadow=0;shape=parallelogram;perimeter=parallelogramPerimeter;rounded=0;" value="&lt;b&gt;L2 INPUT DTO PORT&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;CanonicalTextEnvelope&lt;/font&gt;&lt;br&gt;&lt;br&gt;One DTO containing normalized chunk/view records. L2 preserves IDs/offsets for every score; it does not reopen files or receive original bytes." vertex="1">
          <mxGeometry height="165" width="280" x="2455" y="885" as="geometry" />
        </mxCell>
        <mxCell id="e_prompt_error" value="invalid prompt / schema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.298;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate_prompt" target="t0_error">
